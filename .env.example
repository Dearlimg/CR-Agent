PORT=8080
PERSISTENCE_MODE=mysql
AGENT_SKILLS_DIR=skills
AGENT_MEMORY_DIR=.memory
AGENT_TASKS_DIR=.tasks
AGENT_BACKGROUND_TASKS_DIR=.background-tasks
AGENT_CRON_FILE=.cron-jobs.json
AGENT_TEAM_MAILBOX_DIR=.team-mailboxes
AGENT_TEAM_MAX_CONCURRENCY=2
MODEL_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=32768
# Code review and finding verification output cap; thinking mode is disabled for these calls.
REVIEW_MAX_OUTPUT_TOKENS=8192
MODEL_RETRY_BASE_MS=500
CRON_POLL_INTERVAL_MS=1000
MEMORY_MAX_RECALL=5
MEMORY_MAX_CHARS=6000
MEMORY_CONSOLIDATE_AT=10
CONTEXT_CHAR_LIMIT=250000
TOOL_RESULT_BUDGET=200000
LARGE_RESULT_CHAR_LIMIT=30000
CONTEXT_MAX_MESSAGES=50
CONTEXT_OUTPUT_DIR=.task_outputs/tool-results
CONTEXT_TRANSCRIPT_DIR=.transcripts
AGENT_WORKFLOW_DIR=.workflows
GOAL_MAX_BLOCKS=6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 抓取 GitHub PR diff 走 api.github.com；不配置 GITHUB_TOKEN 时限流 60 次/小时/IP
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
MYSQL_DSN=root:change-me@tcp(127.0.0.1:3307)/cr_agent?charset=utf8mb4&parseTime=True
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REVIEW_BUDGET_YUAN=10
# 按 DeepSeek Flash 高峰时段、输入缓存未命中估算，并以保守汇率 ¥7/USD 折算；价格调整后在此更新。
REVIEW_INPUT_PRICE_YUAN_PER_MILLION=2.1
REVIEW_OUTPUT_PRICE_YUAN_PER_MILLION=8.4

AGENT_DENY_PERMISSIONS=repository_exec,publish_review
