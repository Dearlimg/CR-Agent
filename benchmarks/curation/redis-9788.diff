+            if (ret == AOF_NOT_EXIST || (ret == AOF_TRUNCATED && !last_file)) {
+                ret = AOF_FAILED;
+            }
+
+            if (ret == AOF_OPEN_ERR || ret == AOF_FAILED) {
+                goto cleanup;
+            }
+        }
+    }
