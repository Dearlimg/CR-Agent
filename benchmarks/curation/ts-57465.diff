+
+function isBarNonNull(x: Foo | Bar | null) {
+  return ('bar' in x!);
+}
+const fooOrBar = list[0];
+if (isBarNonNull(fooOrBar)) {
+  const t: Bar = fooOrBar;  // should ok
+}
