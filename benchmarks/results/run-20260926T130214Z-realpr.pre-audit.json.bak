      "status": "completed",
      "duration_ms": 0,
      "references": [
        {
          "file": "tokio-util/src/sync/cancellation_token/tree_node.rs",
          "line": 185,
          "body": "The potential parent might not match and be `Some` here. We shouldn't keep the previous parent locked in that case.",
          "cid": 867329811,
          "author": "Darksonn",
          "dimension": "correctness",
          "kind": "defect"
        },
        {
          "file": "tokio-util/src/sync/cancellation_token/tree_node.rs",
          "line": 348,
          "body": "You should wake the wakers after releasing the lock. Otherwise the future might try to lock the mutex while we're still holding it, which is a waste of resources.",
          "cid": 867331241,
          "author": "Darksonn",
          "dimension": "performance",
          "kind": "defect"
        },
        {
          "file": "tokio-util/src/sync/cancellation_token/tree_node.rs",
          "line": 306,
          "body": "If the node is already cancelled, you can just return immediately.",
