    {
      "id": "pandas-22862",
      "scenario": "refactor",
      "language": "Python",
      "pr_url": "https://github.com/pandas-dev/pandas/pull/22862",
      "title": "REF: Make PeriodArray an ExtensionArray",
      "status": "completed",
      "duration_ms": 0,
      "references": [
        {
          "file": "pandas/core/arrays/period.py",
          "line": 166,
          "body": "I think we *always* need to copy here, e.g. if you pass in an ndarray with copy=False this makes the internals mutable which is not great.",
          "cid": 226629141,
          "author": "jreback",
          "dimension": "correctness",
          "kind": "defect"
        },
        {
          "file": "pandas/core/arrays/period.py",
          "line": 75,
          "body": "Yes, return NotImplemented. Also presumably ABCDataFrame. (Comparison operators should return NotImplemented instead of raising for unsupported operands.)",
          "cid": 226800296,
          "author": "jbrockmendel",
          "dimension": "correctness",
          "kind": "suggestion"
        },
        {
          "file": "pandas/core/arrays/period.py",
          "line": 147,
          "body": "shouldn't this be simpler and instead just call ``period_array``?",
          "cid": 224703904,
          "author": "jorisvandenbossche",
          "dimension": "maintainability",
          "kind": "suggestion"
        }
      ],
      "findings": [
        {
          "file": "pandas/tests/series/test_constructors.py",
          "line": 866,
          "severity": "low",
          "confidence": "high",
          "body": "test_constructor_infer_period 第二段把 data 换成 object ndarray 后，仍然断言上一次由 list 构造出的 result，没有重新构造 Series，因此新增的 object ndarray 推断路径实际上未被测试覆盖。",
          "evidence": "data = np.asarray(data, dtype=object)\n        tm.assert_series_equal(result, expected)",
          "trigger": "运行该测试用例；或修改 _try_cast 中 object ndarray 相关逻辑时。",
          "impact": "测试给出虚假的覆盖信心：object ndarray 输入是否被转换为 PeriodDtype 不经验证，回归不会被捕获。",
          "suggestion": "改为 result = pd.Series(data)（在 data = np.asarray(data, dtype=object) 之后）再断言 result.dtype 与 expected，或显式断言断言双方的数据来源。",
          "verification_status": "second_pass_review_passed",
          "verification_reason": "新增测试 test_constructor_infer_period 中，result 仅在第一次以 list 构造时被赋值（result = pd.Series(data)），随后 data = np.asarray(data, dtype=object) 只重新绑定了 data，并未重建 Series；第 866-868 行的两次断言仍引用同一个旧的 result 与 expected，因此 object ndarray 从构造到推断 dtype 的代码路径根本没有被执行，断言第二次运行与第一次完全等价。候选 finding 描述的机制在可见代码中成立，且影响（虚假覆盖信心、回归不会被捕获）可由该冗余断言直接推导。",
          "trace_id": "cfcdf1c071eea96f"
        }
      ],
      "reference_verdicts": [
        {
          "index": 0,
          "verdict": "not_covered",
          "reason": "No finding addresses the copy semantics of PeriodArray.__init__ (always copying vs. honoring copy=False and exposing a mutable ndarray). The only system finding concerns a test in test_constructors.py."
        },
        {
          "index": 1,
          "verdict": "not_covered",
          "reason": "No finding mentions returning NotImplemented (or handling ABCDataFrame) in the comparison wrapper at pandas/core/arrays/period.py:75."
        },
        {
          "index": 2,
          "verdict": "not_covered",
          "reason": "No finding comments on simplifying PeriodArray construction by delegating to period_array (period.py around line 147)."
        }
      ],
      "finding_verdicts": [
        {
          "index": 0,
          "verdict": "valid_new_issue",
          "reason": "Accurate and actionable: in test_constructor_infer_period, after `data = np.asarray(data, dtype=object)` the test re-asserts the previously constructed `result` instead of rebuilding `pd.Series(data)`, so the object-ndarray inference path is never exercised. A reviewer would legitimately flag this; the human comments on this PR did not."
        }
      ],
